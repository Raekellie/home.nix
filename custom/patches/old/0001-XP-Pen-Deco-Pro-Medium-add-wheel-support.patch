 .../Configurations/XP-Pen/Deco Pro Medium.json            | 8 +++++++-
 TABLETS.md                                                | 2 +-
 2 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/OpenTabletDriver.Configurations/Configurations/XP-Pen/Deco Pro Medium.json b/OpenTabletDriver.Configurations/Configurations/XP-Pen/Deco Pro Medium.json
index aa7e9318..ac7ed6f9 100644
